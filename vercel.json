{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/image-tools/watermark-removal/tasks",
      "destination": "/api/watermark-removal"
    },
    {
      "source": "/api/image-tools/:path*",
      "destination": "https://api.wristo.io/api/image-tools/:path*"
    },
    {
      "source": "/wristo-api/:path*",
      "destination": "https://api.wristo.io/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
